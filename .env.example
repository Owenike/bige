# Canonical public app origin used by auth redirects and blackbox base URL fallback.
# Set without a trailing slash, for example: https://booking.example.com
NEXT_PUBLIC_APP_URL=

# Required for app/api/* auth + Supabase server client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional dedicated operational access. Prefer Supabase app_metadata capabilities
# for staff accounts; this remains available for standalone legacy admin accounts.
STUDENT_CHECKIN_ADMIN_EMAILS=

# Required for entry token issue/verify
ENTRY_TOKEN_SECRET=

# Optional integrations / jobs
CRON_SECRET=
JOB_RERUN_PREVIEW_SECRET=
NEWEBPAY_CHECKOUT_URL=
NEWEBPAY_WEBHOOK_URL=
NEWEBPAY_WEBHOOK_SECRET=

# Optional ACpay test integration
NEXT_PUBLIC_ACPAY_TRIAL_PAYMENT_ENABLED=false
ACPAY_ENV=test
ACPAY_MERCHANT_NO=090414780201003
ACPAY_SECRET_KEY=
ACPAY_API_ROOT=https://aiodir.payloop.com.tw
ACPAY_API_ROOT2=https://aio.payloop.com.tw
APP_BASE_URL=https://bigefitness.com
ACPAY_TRIAL_AMOUNT=880
ACPAY_TEST_ACTION_TOKEN=

# Optional gate integration
GATE_CONTROLLER_ENDPOINT=
GATE_CONTROLLER_API_KEY=

# Optional notify integrations
LINE_CHANNEL_ACCESS_TOKEN=
LINE_BOOKING_NOTIFY_TO=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_SESSION_SECRET=
LINE_NOTIFY_ENDPOINT=
LINE_NOTIFY_TOKEN=
LINE_NOTIFY_PROVIDER=line_messaging_api
LINE_NOTIFY_TIMEOUT_MS=

SMS_NOTIFY_ENDPOINT=
SMS_NOTIFY_TOKEN=
SMS_NOTIFY_PROVIDER=
SMS_NOTIFY_TIMEOUT_MS=

EMAIL_NOTIFY_ENDPOINT=
EMAIL_NOTIFY_TOKEN=
EMAIL_NOTIFY_PROVIDER=
EMAIL_NOTIFY_FROM=
EMAIL_NOTIFY_REPLY_TO=
EMAIL_NOTIFY_TIMEOUT_MS=
EMAIL_NOTIFY_WEBHOOK_TOKEN=
EMAIL_NOTIFY_WEBHOOK_SECRET=
